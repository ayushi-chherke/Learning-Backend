<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <h3> Edit ID: <%= chat._id%>
    </h3>
    <p>The Chat was Sent from <i><b><%= chat.from%></b></i> to <i><b><%= chat.to%></b></i>!
    </p>
    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
    <textarea name="msg" rows="10" cols="50"><%= chat.msg %></textarea><br><br />
    <br><br>
    <button>Edit Chat</button>
</form>
</body>
</html>
